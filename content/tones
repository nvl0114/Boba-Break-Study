<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Boba Break Study - Courses</title>

    <link rel="stylesheet" href="style.css">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">


    <style>

        .section-header h1 {
            font-size: 36px;
            color: #b8865c;
            font-weight: 700;
            margin-bottom: 8px;
        }


        .section-header p {
            font-size: 17px;
            color: #6e5c52;
            margin-bottom: 30px;
        }


        .course-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 24px;
            margin-top: 20px;
        }


        .course-card {
            background: #fff;
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 8px 20px rgba(0,0,0,.08);
        }


        .card-img-placeholder {
            width: 100%;
            height: 180px;
            background: #f8efe7;
            border-radius: 16px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 18px;
        }


        .card-img-placeholder i {
            font-size: 60px;
            color: #b8865c;
        }


    </style>

</head>


