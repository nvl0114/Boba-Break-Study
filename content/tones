                    </a>
                </li>


                <li>
                    <a href="about.html">
                        <i class="fa-solid fa-circle-info"></i>
                        About
                    </a>
                </li>


            </ul>

        </nav>


    </aside>




    <!-- Main Content -->
    <main class="main-content">


        <div class="courses-section">


            <!-- Header -->
            <div class="section-header">


                <h1>
                    Explore Courses
